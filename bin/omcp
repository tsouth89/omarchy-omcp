    available = []
    for line in run(["omarchy", "powerprofiles", "list"], check=False).splitlines():
        name = line.split("\t")[0].strip()
        if name:
            available.append(name)
    if wanted not in available:
        raise ToolError("no power profile called %r. Available: %s" % (wanted, ", ".join(available)))
    run(["omarchy", "powerprofiles", "set", "autodetect", wanted], timeout=20)
    return {"profile": wanted}, "set the power profile to %s" % wanted


