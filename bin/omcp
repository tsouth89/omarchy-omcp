#!/usr/bin/env python3
"""OMCP — the Omarchy desktop, exposed to AI agents as an MCP server.

Speaks MCP over stdio, so an agent launches this file directly. Every tool is a
fixed verb over an existing Omarchy or Wayland CLI; there is deliberately no
tool that runs an arbitrary command. Each call is checked against a permission
map the user owns, written to an activity log the bar widget tails, and — for
anything gated as "ask" — held until the user approves it in the panel.

Python 3 standard library only, so it starts as fast as the shell can fork it
and never has to be installed.
"""

import base64
import fcntl
import json
import os
import pwd
import queue
import re
import secrets
import signal
import stat
import subprocess
import sys
import tempfile
import threading
import time

VERSION = "1.1.0"
PROTOCOL_DEFAULT = "2025-06-18"
SUPPORTED_PROTOCOLS = ("2024-11-05", "2025-03-26", "2025-06-18")


def passwd_home():
    """The account's real home, ignoring a forged HOME from the MCP client."""
    try:
        return pwd.getpwuid(os.getuid()).pw_dir
    except KeyError:
        return os.path.expanduser("~")


# MCP clients routinely pass an `env` block. Honouring HOME / XDG_* from that
# process would point the permission file at a tree the panel is not watching,
# so the ghost can show Paused while the server is fully armed. Config and
# state always live under the passwd home, matching what README documents.
HOME = passwd_home()
CONFIG_DIR = os.path.join(HOME, ".config", "omcp")
STATE_DIR = os.path.join(HOME, ".local", "state", "omcp")

CONFIG_PATH = os.path.join(CONFIG_DIR, "config.json")
ACTIVITY_PATH = os.path.join(STATE_DIR, "activity.jsonl")
AGENTS_PATH = os.path.join(STATE_DIR, "agents.json")
PENDING_PATH = os.path.join(STATE_DIR, "pending.json")
DECISION_DIR = os.path.join(STATE_DIR, "decisions")

ACTIVITY_KEEP = 300          # lines retained in the feed the panel reads
AGENT_STALE_SECONDS = 60     # an agent that stops heartbeating is gone
ASK_TIMEOUT_SECONDS = 60     # how long a held tool call waits for a decision
CLIPBOARD_READ_LIMIT = 200000  # a selection larger than this is returned truncated
SCREENSHOT_MAX_BYTES = 8 * 1024 * 1024  # refuse a capture that would blow the MCP line
TRUSTED_BIN_DIRS = ("/usr/share/omarchy/bin", "/usr/local/bin", "/usr/bin")


def now():
    return int(time.time())


def ensure_dirs():
    # 0700, and re-applied to directories that already exist: pending.json
    # carries the raw arguments of a held call, which for write_clipboard is the
    # clipboard text itself, and the activity log records what every agent did.
    # None of that should be readable by other local accounts.
    for d in (CONFIG_DIR, STATE_DIR, DECISION_DIR):
        os.makedirs(d, mode=0o700, exist_ok=True)
        try:
            os.chmod(d, 0o700)
        except OSError:
            pass
    # O_CREAT only sets the mode on creation, so a file written by an older
    # version keeps its permissive mode forever unless it is corrected here.
    for f in (ACTIVITY_PATH, AGENTS_PATH, PENDING_PATH, CONFIG_PATH):
        try:
            info = os.lstat(f)
        except OSError:
            continue
        # Regular files only. Someone who symlinked their config into a dotfiles
        # repo should not have this quietly rewrite the target's mode.
        if not stat.S_ISREG(info.st_mode) or not (info.st_mode & 0o077):
            continue
        try:
            os.chmod(f, 0o600)
        except OSError:
            pass


def write_atomic(path, text):
    """Replace a file in one step so a reader never sees a half-written file.

    The QML side watches these with inotify and re-parses on every change; a
    truncate-then-write would hand it invalid JSON on the way through.
    """
    ensure_dirs()
    # A unique temp name per call, not one keyed on the pid: the heartbeat
    # thread and the request thread both write this file, and a shared name
    # lets one truncate the other's partial write and then publish it.
    directory = os.path.dirname(path) or "."
    fd, tmp = tempfile.mkstemp(dir=directory, prefix=os.path.basename(path) + ".", suffix=".tmp")
    try:
        with os.fdopen(fd, "w", encoding="utf-8") as fh:
            fh.write(text)
            fh.flush()
            os.fsync(fh.fileno())
        os.chmod(tmp, 0o600)
        os.replace(tmp, path)
    except BaseException:
        try:
            os.unlink(tmp)
        except OSError:
            pass
        raise


_THREAD_LOCKS = {}
_THREAD_LOCKS_GUARD = threading.Lock()


def _thread_lock(name):
    with _THREAD_LOCKS_GUARD:
        lock = _THREAD_LOCKS.get(name)
        if lock is None:
            lock = threading.RLock()
            _THREAD_LOCKS[name] = lock
        return lock


class FileLock:
    """A cross-process and in-process lock.

    Several agents can be connected at once, each with its own server process,
    all appending to one activity log and rewriting one agent registry. flock
    is per-process on Linux, so the heartbeat thread and the worker also share
    a threading lock of the same name.
    """

    def __init__(self, name):
        ensure_dirs()
        self.name = name
        self.path = os.path.join(STATE_DIR, name + ".lock")
        self.fd = None
        self._thread = None

    def __enter__(self):
        self._thread = _thread_lock(self.name)
        self._thread.acquire()
        try:
            self.fd = os.open(self.path, os.O_CREAT | os.O_RDWR, 0o600)
            fcntl.flock(self.fd, fcntl.LOCK_EX)
        except OSError:
            if self.fd is not None:
                os.close(self.fd)
                self.fd = None
            self._thread.release()
            self._thread = None
            raise
        return self

    def __exit__(self, *_):
        try:
            if self.fd is not None:
                try:
                    fcntl.flock(self.fd, fcntl.LOCK_UN)
                finally:
                    os.close(self.fd)
                    self.fd = None
        finally:
            if self._thread is not None:
                self._thread.release()
                self._thread = None
        return False


def read_json(path, fallback):
    try:
        with open(path, "r", encoding="utf-8") as fh:
            return json.load(fh)
    except (OSError, ValueError):
        return fallback


# --------------------------------------------------------------------- config
#
# Three permission states per tool. `allow` runs it, `ask` holds it until the
# user answers in the panel, `deny` refuses without running anything. Fresh
# installs begin with catalogue defaults; once a config exists it stores a
# complete reviewed map, so an update cannot silently grant a newly added tool.

ALLOW, ASK, DENY = "allow", "ask", "deny"
PROFILE_NAMES = ("observe", "present", "operate")

# Named profiles are deliberately derived from capability classes here, in the
# server that enforces them. The QML panel only asks for a profile by name; it
# never owns a second permission map that could drift away from this one.
PRESENT_TOOLS = {
    "set_theme", "set_wallpaper", "send_notification", "focus_window",
    "move_window_to_workspace", "switch_workspace", "set_volume",
    "set_brightness", "set_do_not_disturb", "set_night_light",
    "set_reminder", "set_power_profile", "set_stay_awake",
    "set_window_floating", "set_window_fullscreen",
}
SENSITIVE_READS = {"screenshot", "read_clipboard"}
REVIEWED_READS = {
    "get_active_window", "list_windows", "list_workspaces",
    "get_current_theme", "list_themes", "list_apps", "get_system_stats",
    "list_monitors", "get_weather", "get_network_status",
}


def default_permissions():
    return {name: spec["default"] for name, spec in TOOLS.items()}


def profile_permissions(profile):
    """Return the complete permission map for a named profile.

    New tools fail closed in Observe and Present: reads require approval and
    writes stay Off until the profile definition deliberately includes them.
    Operate tracks the reviewed catalogue defaults.
    """
    if profile not in PROFILE_NAMES:
        raise ValueError("unknown profile: %s" % profile)
    if profile == "operate":
        return default_permissions()
    permissions = {}
    for name, spec in TOOLS.items():
        if profile == "observe":
            if spec["write"]:
                permissions[name] = DENY
            elif name in REVIEWED_READS:
                permissions[name] = ALLOW
            else:
                permissions[name] = ASK
        elif name in PRESENT_TOOLS:
            permissions[name] = ALLOW
        elif spec["write"]:
            permissions[name] = DENY
        elif name in REVIEWED_READS:
            permissions[name] = ALLOW
        else:
            permissions[name] = ASK
    return permissions


def detect_profile(permissions):
    for profile in PROFILE_NAMES:
        if permissions == profile_permissions(profile):
            return profile
    return "custom"


def load_config():
    exists = os.path.exists(CONFIG_PATH)
    stored = read_json(CONFIG_PATH, None)
    if not isinstance(stored, dict):
        stored = {}
    declared_profile = stored.get("profile")
    if not exists:
        # A genuinely fresh install gets the reviewed shipping defaults.
        perms = default_permissions()
    elif declared_profile in PROFILE_NAMES:
        # A profile remains a policy across upgrades. Any newly introduced tool
        # receives that profile's fail-closed classification rather than its
        # catalogue default.
        perms = profile_permissions(declared_profile)
    else:
        # Existing custom and legacy configs preserve every stored choice, but
        # a tool they have never seen must be reviewed before it can run.
        perms = {name: ASK for name in TOOLS}
    for name, value in (stored.get("tools") or {}).items():
        if name in perms and value in (ALLOW, ASK, DENY):
            perms[name] = value
    profile = declared_profile
    if profile not in PROFILE_NAMES or perms != profile_permissions(profile):
        profile = detect_profile(perms)
    return {
        "version": 1,
        "profile": profile,
        "paused": bool(stored.get("paused", False)),
        "tools": perms,
        "notifyOnConnect": bool(stored.get("notifyOnConnect", True)),
    }


def save_config(config):
    permissions = config.get("tools", {})
    write_atomic(CONFIG_PATH, json.dumps({
        "version": 1,
        "profile": detect_profile(permissions),
        "paused": bool(config.get("paused", False)),
        "notifyOnConnect": bool(config.get("notifyOnConnect", True)),
        "tools": permissions,
    }, indent=2) + "\n")


def mutate_config(mutator):
    """Load, change, and write config.json under the config lock.

    Pause, permission, and notify clicks all fire as overlapping CLI processes
    from the panel. Without this, a set that loaded `paused: false` can persist
    after the user already saved `paused: true`.
    """
    with FileLock("config"):
        config = load_config()
        mutator(config)
        save_config(config)
        return config


# ------------------------------------------------------------------- activity
#
# One JSON object per line, newest last, capped. This is the only channel
# between the server and the bar widget: the widget watches the file, so a tool
# call lights up the ghost without anything polling anything.

def log_activity(entry):
    ensure_dirs()
    entry = dict(entry)
    entry.setdefault("ts", now())
    # The feed is scanned, not read. Long validation errors (a full theme list,
    # say) would otherwise push everything else off the panel.
    summary = str(entry.get("summary", ""))
    if len(summary) > 160:
        entry["summary"] = summary[:157] + "..."
    line = json.dumps(entry, ensure_ascii=False)
    try:
        # The log is the audit trail, and several servers append to it at once.
        # Appending and rotating under one lock keeps a rotation from dropping
        # another process's line.
        with FileLock("activity"):
            fd = os.open(ACTIVITY_PATH, os.O_WRONLY | os.O_CREAT | os.O_APPEND, 0o600)
            with os.fdopen(fd, "a", encoding="utf-8") as fh:
                fh.write(line + "\n")
            _trim_activity()
    except OSError:
        return


def _trim_activity():
    try:
        with open(ACTIVITY_PATH, "r", encoding="utf-8") as fh:
            lines = fh.readlines()
    except OSError:
        return
    if len(lines) <= ACTIVITY_KEEP * 2:
        return
    # Deliberately NOT write_atomic: replacing the file would hand the panel a
    # new inode and quietly kill its inotify watch, so the feed would freeze the
    # first time the log rotated. Truncating in place keeps the same file. A
    # reader that catches us mid-rewrite sees a short file, and the parser is
    # already built to skip a partial line.
    try:
        with open(ACTIVITY_PATH, "w", encoding="utf-8") as fh:
            fh.write("".join(lines[-ACTIVITY_KEEP:]))
    except OSError:
        pass


def read_activity(limit=ACTIVITY_KEEP):
    try:
        with open(ACTIVITY_PATH, "r", encoding="utf-8") as fh:
            lines = fh.readlines()
    except OSError:
        return []
    out = []
    for line in lines[-limit:]:
        line = line.strip()
        if not line:
            continue
        try:
            out.append(json.loads(line))
        except ValueError:
            continue
    return out


# --------------------------------------------------------------------- agents
#
# Every connected agent registers itself here and refreshes `lastSeen` on a
# background heartbeat. Nothing removes an entry for an agent that was killed
# rather than closed, so readers treat anything older than AGENT_STALE_SECONDS
# as gone — that keeps the liveness check on the reader instead of needing a
# daemon to sweep.

def pid_alive(pid):
    """Is this our own still-running process?

    EPERM used to count as alive, which meant a recycled pid now owned by
    another user kept a departed agent lit in the panel. Only a process we can
    actually signal is one of ours.
    """
    try:
        os.kill(int(pid), 0)
    except (OSError, TypeError, ValueError):
        # Includes EPERM: a pid we cannot signal is owned by someone else, so
        # it is not the agent that registered here.
        return False
    return True


def live_agents():
    data = read_json(AGENTS_PATH, {})
    cutoff = now() - AGENT_STALE_SECONDS
    out = []
    for agent in data.get("agents", []):
        if agent.get("lastSeen", 0) < cutoff:
            continue
        if not pid_alive(agent.get("pid")):
            continue
        out.append(agent)
    return out


def register_agent(agent):
    # Read-modify-write across processes: without the lock, two agents
    # heartbeating together each publish a snapshot taken before the other's
    # update, and one of them silently vanishes from the panel.
    with FileLock("agents"):
        others = [a for a in live_agents() if a.get("pid") != agent.get("pid")]
        write_atomic(AGENTS_PATH, json.dumps({"agents": others + [agent]}, indent=2) + "\n")


def unregister_agent(pid):
    with FileLock("agents"):
        others = [a for a in live_agents() if a.get("pid") != pid]
        write_atomic(AGENTS_PATH, json.dumps({"agents": others}, indent=2) + "\n")


# ------------------------------------------------------------------ approvals
#
# A tool set to `ask` is not refused and is not run: it is parked. The request
# goes into pending.json, the panel picks it up over inotify and shows Approve
# / Deny, and this call blocks until an answer lands or the request expires.
# Denying on timeout is the only safe default — an unattended machine should
# not grant anything.
#
# One request is in flight at a time. The lock is an O_EXCL create, so two
# agents asking at once queue instead of overwriting each other's prompt.

PENDING_LOCK = PENDING_PATH + ".lock"


def _clear_pending(force=False):
    """Release the approval slot. Returns whether this process still held it.

    A late `finally` used to delete whatever lock happened to be there. Once a
    holder's claim expires another agent legitimately takes the slot, so the
    tardy cleanup would delete the *new* holder's live lock and prompt, and its
    request would sit invisible until it timed out. The pid stamped into the
    lock at creation says whose it is; only a deliberate steal ignores it.
    """
    if not force:
        try:
            with open(PENDING_LOCK, "r", encoding="utf-8") as fh:
                if int(json.load(fh).get("pid", -1)) != os.getpid():
                    return False
        except (OSError, ValueError, TypeError):
            pass                      # unreadable: the caller judged it stale
    for path in (PENDING_PATH, PENDING_LOCK):
        try:
            os.unlink(path)
        except OSError:
            pass
    return True


def _lock_expiry():
    """When the current holder's claim runs out, or None if not yet readable."""
    try:
        with open(PENDING_LOCK, "r", encoding="utf-8") as fh:
            return int(json.load(fh).get("expires", 0))
    except (OSError, ValueError, TypeError):
        return None


def _acquire_pending_slot(deadline, expires):
    """Claim the single approval slot, or give up at `deadline`.

    The expiry is stamped into the lock file itself at creation rather than
    inferred from pending.json. Reading pending.json instead left a window: a
    second agent arriving after the lock was created but before the payload was
    written saw no request, concluded the holder was dead, deleted the live
    lock, and took the slot too — so both wrote pending.json, the user only ever
    saw one prompt, and whichever agent lost silently waited out its timeout.
    """
    while True:
        try:
            fd = os.open(PENDING_LOCK, os.O_CREAT | os.O_EXCL | os.O_WRONLY, 0o600)
            try:
                os.write(fd, json.dumps({"expires": expires, "pid": os.getpid()}).encode())
            finally:
                os.close(fd)
            return True
        except FileExistsError:
            held = _lock_expiry()
            if held is None:
                # Created but not yet stamped, or corrupt. Only reclaim once it
                # is far too old for a live holder to still be mid-write.
                try:
                    stale = (time.time() - os.stat(PENDING_LOCK).st_mtime) > 5
                except OSError:
                    continue                      # vanished; try to claim it
                if stale:
                    _clear_pending(force=True)
                    continue
            elif held < now():
                _clear_pending(force=True)        # holder timed out or died
                continue
            if time.time() > deadline:
                return False
            time.sleep(0.2)
        except OSError:
            return False


def request_approval(agent_name, tool, summary, detail):
    deadline = time.time() + ASK_TIMEOUT_SECONDS
    expires = int(deadline)
    if not _acquire_pending_slot(deadline, expires):
        return False, "another approval request is already waiting"

    request_id = secrets.token_urlsafe(12)
    write_atomic(PENDING_PATH, json.dumps({
        "id": request_id,
        "agent": agent_name,
        "tool": tool,
        "summary": summary,
        "detail": detail,
        "asked": now(),
        "expires": expires,
    }, indent=2) + "\n")

    log_activity({"agent": agent_name, "tool": tool, "state": "asked", "summary": summary})
    # Clear any prompt still on screen from a previous request before posting
    # this one, so a server that died without cleaning up cannot leave a stale
    # prompt sitting next to the live one.
    dismiss_notification(ASK_HEADLINE)
    notify(ASK_HEADLINE, "%s wants to %s" % (agent_name, summary),
           urgency="critical", exec_on_click="omarchy-shell omcp open")

    answer_path = decision_path(request_id)
    try:
        while time.time() < deadline:
            decision = read_json(answer_path, None)
            if decision is not None:
                granted = decision.get("decision") == "allow"
                return granted, "approved in the panel" if granted else "denied in the panel"
            time.sleep(0.15)
        return False, "no answer within %ds" % ASK_TIMEOUT_SECONDS
    finally:
        # Release before dismissing, and dismiss only if the slot was still
        # ours: the prompt is identified by a shared headline, so clearing it
        # after another agent has taken over would wipe their prompt instead.
        still_ours = _clear_pending()
        if still_ours:
            dismiss_notification(ASK_HEADLINE)
        try:
            os.unlink(answer_path)
        except OSError:
            pass


# token_urlsafe alphabet. Anchored so a caller-supplied id cannot walk out of
# DECISION_DIR via slashes, dots, or a trailing newline.
REQUEST_ID_RE = re.compile(r"[A-Za-z0-9_-]{8,32}\Z")


def decision_path(request_id):
    """Map a request id to its decision file, refusing anything that is not one.

    The id is minted by this program and only ever handed back to us.
    Concatenating it into a path unchecked meant a caller-supplied id could
    walk out of the directory. Validate the shape, then keep only the
    basename, so neither traversal nor an absolute path can survive.
    """
    request_id = str(request_id)
    if not REQUEST_ID_RE.fullmatch(request_id):
        raise ToolError("malformed request id")
    return os.path.join(DECISION_DIR, os.path.basename(request_id) + ".json")


def write_decision(request_id, decision):
    ensure_dirs()
    write_atomic(decision_path(request_id),
                 json.dumps({"id": request_id, "decision": decision, "at": now()}) + "\n")


# ---------------------------------------------------------------- run helpers
#
# Everything the tools do goes through here: an argv list, never a string, and
# never a shell. There is no code path in this file that concatenates a caller's
# argument into something a shell will parse.

class ToolError(Exception):
    pass


def resolve_bin(name):
    """Look up a desktop CLI on a fixed path, not the MCP client's PATH."""
    if not name or os.path.sep in name or name in (".", "..") or name.startswith("."):
        return None
    for directory in TRUSTED_BIN_DIRS:
        path = os.path.join(directory, name)
        if os.path.isfile(path) and os.access(path, os.X_OK):
            return path
    return None


def argv_trusted(args):
    resolved = resolve_bin(args[0])
    if not resolved:
        raise ToolError("%s is not installed on this machine" % args[0])
    return [resolved] + list(args[1:])


def run(args, timeout=15, check=True):
    argv = argv_trusted(args)
    try:
        proc = subprocess.run(argv, capture_output=True, text=True, timeout=timeout)
    except subprocess.TimeoutExpired:
        raise ToolError("%s timed out after %ds" % (args[0], timeout))
    if check and proc.returncode != 0:
        message = (proc.stderr or proc.stdout or "").strip().splitlines()
        raise ToolError("%s failed: %s" % (args[0], message[0] if message else "exit %d" % proc.returncode))
    return proc.stdout


def run_json(args, timeout=15):
    raw = run(args, timeout=timeout)
    try:
        return json.loads(raw)
    except ValueError:
        raise ToolError("%s returned output that was not JSON" % " ".join(args[:2]))


def launch_detached(args, settle=1.5):
    """Start something that outlives this call.

    `gio launch` and `xdg-open` do not exit when the app is up — they hang
    around supervising it, holding whatever pipes they inherited. Waiting on
    them the way run() does would block until the user closed the app. So the
    child gets its own session and no pipes, and we only wait long enough to
    catch the failures that are immediate: a bad desktop entry, a missing
    handler. Still running after that means it worked.
    """
    argv = argv_trusted(args)
    proc = subprocess.Popen(argv, stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL,
                            stderr=subprocess.DEVNULL, start_new_session=True)
    try:
        proc.wait(timeout=settle)
    except subprocess.TimeoutExpired:
        return
    if proc.returncode != 0:
        raise ToolError("%s exited with code %d" % (args[0], proc.returncode))


ASK_HEADLINE = "OMCP is waiting"


def dismiss_notification(headline):
    """Take a notification back off the screen.

    Omarchy gives critical notifications a duration of 0 — they never expire, so
    the user can't miss one. That is right for an approval prompt while it is
    still live, and wrong the moment it is answered: without this the prompts
    pile up on screen forever, one per request.
    """
    try:
        subprocess.run(argv_trusted(["omarchy", "notification", "dismiss", headline]),
                       stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL,
                       stderr=subprocess.DEVNULL, timeout=10)
    except (OSError, subprocess.SubprocessError, ToolError):
        pass


def notify(title, body="", urgency="normal", exec_on_click=None):
    args = ["omarchy", "notification", "send", "--app-name", "OMCP", "-u", urgency]
    if exec_on_click:
        args += ["--exec", exec_on_click]
    args += [title]
    if body:
        args += [body]
    try:
        subprocess.run(argv_trusted(args), capture_output=True, text=True, timeout=10)
    except (OSError, subprocess.SubprocessError, ToolError):
        pass


# ------------------------------------------------------------------ validators

def clean_label(value, fallback, limit=64):
    """Make a client-supplied string safe to display and to pass as an argv word.

    The name in an MCP handshake is whatever the client says it is — it
    identifies, it never authenticates. Control characters would corrupt the
    single-line log format, and a leading dash could be read as an option by a
    command this name is interpolated into.
    """
    text = re.sub(r"[\x00-\x1f\x7f-\x9f\u200b-\u200f\u2028\u2029\u202a-\u202e\u2066-\u2069]",
                  " ", str(value or "")).strip()
    text = re.sub(r"\s+", " ", text).lstrip("-").strip()
    if not text:
        return fallback
    return text[:limit]


ADDRESS_RE = re.compile(r"^0x[0-9a-fA-F]{4,16}$")
IMAGE_EXTENSIONS = (".jpg", ".jpeg", ".png", ".webp", ".gif", ".bmp")


def want(args, key):
    value = args.get(key)
    if value is None or (isinstance(value, str) and not value.strip()):
        raise ToolError("%s is required" % key)
    return value


def want_int(args, key, low, high):
    try:
        value = int(args.get(key))
    except (TypeError, ValueError):
        raise ToolError("%s must be a whole number between %d and %d" % (key, low, high))
    if not low <= value <= high:
        raise ToolError("%s must be between %d and %d" % (key, low, high))
    return value


def want_bool(args, key, default=None):
    if key not in args:
        if default is None:
            raise ToolError("%s is required" % key)
        return default
    value = args[key]
    if isinstance(value, bool):
        return value
    if value == 0 or value == 1:
        return bool(value)
    raise ToolError("%s must be true or false" % key)


def want_address(args, key="address"):
    address = str(want(args, key)).strip()
    if not ADDRESS_RE.match(address):
        raise ToolError("%s must be a Hyprland window address like 0x55c2f0d67580" % key)
    known = {client.get("address") for client in run_json(["hyprctl", "-j", "clients"])}
    if address not in known:
        raise ToolError("no open window has the address %s — call list_windows for current addresses" % address)
    return address


def want_url(args, key="url"):
    url = str(want(args, key)).strip()
    if re.search(r"[\s\x00-\x1f]", url):
        raise ToolError("url must not contain spaces or control characters")
    if not re.match(r"^https?://[^\s/$.?#][^\s]*$", url):
        raise ToolError("url must be a http:// or https:// address")
    return url


# ---------------------------------------------------------------- reads

def tool_get_active_window(args):
    window = run_json(["hyprctl", "-j", "activewindow"])
    if not window or not window.get("address"):
        return {"focused": None}, "read the focused window"
    out = {
        "address": window.get("address"),
        "class": window.get("class"),
        "title": window.get("title"),
        "workspace": (window.get("workspace") or {}).get("name"),
        "floating": window.get("floating"),
        "fullscreen": bool(window.get("fullscreen")),
        "monitor": window.get("monitor"),
    }
    return out, "read the focused window"


def tool_list_windows(args):
    clients = run_json(["hyprctl", "-j", "clients"])
    windows = [{
        "address": c.get("address"),
        "class": c.get("class"),
        "title": c.get("title"),
        "workspace": (c.get("workspace") or {}).get("name"),
        "floating": c.get("floating"),
    } for c in clients if c.get("mapped", True)]
    return {"windows": windows, "count": len(windows)}, "listed %d windows" % len(windows)


def tool_list_workspaces(args):
    workspaces = run_json(["hyprctl", "-j", "workspaces"])
    active = run_json(["hyprctl", "-j", "activeworkspace"]) or {}
    rows = sorted(({
        "id": w.get("id"),
        "name": w.get("name"),
        "windows": w.get("windows"),
        "monitor": w.get("monitor"),
        "active": w.get("id") == active.get("id"),
    } for w in workspaces), key=lambda w: (w["id"] is None, w["id"]))
    return {"workspaces": rows, "active": active.get("name")}, "listed workspaces"


def current_theme():
    return run(["omarchy", "theme", "current"]).strip()


def theme_names():
    return [line.strip() for line in run(["omarchy", "theme", "list"]).splitlines() if line.strip()]


def tool_get_current_theme(args):
    return {"theme": current_theme()}, "read the current theme"


def tool_list_themes(args):
    names = theme_names()
    return {"themes": names, "current": current_theme()}, "listed %d themes" % len(names)


def desktop_entries():
    """Every launchable .desktop on this machine, newest trusted dir wins.

    XDG_DATA_DIRS is not consulted: the MCP client can prepend a writable
    directory of desktop files whose Name= looks like a real app.
    """
    dirs = [
        os.path.join(HOME, ".local", "share", "applications"),
        "/usr/local/share/applications",
        "/usr/share/applications",
    ]
    found = {}
    for directory in dirs:
        if not os.path.isdir(directory):
            continue
        for name in sorted(os.listdir(directory)):
            if not name.endswith(".desktop"):
                continue
            app_id = name[:-len(".desktop")]
            if app_id in found:
                continue
            path = os.path.join(directory, name)
            entry = {"id": app_id, "name": app_id, "path": path, "keywords": ""}
            try:
                with open(path, "r", encoding="utf-8", errors="replace") as fh:
                    in_main = False
                    for line in fh:
                        line = line.strip()
                        if line.startswith("["):
                            in_main = line == "[Desktop Entry]"
                            continue
                        if not in_main:
                            continue
                        if line.startswith("Name=") and entry["name"] == app_id:
                            entry["name"] = line[5:].strip()
                        elif line.startswith(("GenericName=", "Keywords=", "Comment=")):
                            entry["keywords"] += " " + line.split("=", 1)[1]
                        elif line.startswith("NoDisplay=") and line[10:].strip().lower() == "true":
                            entry["hidden"] = True
                        elif line.startswith("Type=") and line[5:].strip() != "Application":
                            entry["hidden"] = True
            except OSError:
                continue
            found[app_id] = entry
    return found


def tool_list_apps(args):
    entries = [e for e in desktop_entries().values() if not e.get("hidden")]
    query = str(args.get("query") or "").strip().lower()
    if query:
        entries = [e for e in entries
                   if query in e["id"].lower() or query in e["name"].lower()
                   or query in e.get("keywords", "").lower()]
    rows = sorted(({"id": e["id"], "name": e["name"]} for e in entries), key=lambda e: e["name"].lower())
    return {"apps": rows, "count": len(rows)}, "listed %d apps" % len(rows)


def focused_output():
    for monitor in run_json(["hyprctl", "-j", "monitors"]):
        if monitor.get("focused"):
            return monitor.get("name")
    return None


def tool_screenshot(args):
    target = str(args.get("target") or "screen").strip()
    image_format = str(args.get("format") or "jpeg").strip().lower()
    if image_format not in ("jpeg", "png"):
        raise ToolError("format must be jpeg or png")

    command = ["grim", "-t", image_format]
    if image_format == "jpeg":
        command += ["-q", str(want_int(args, "quality", 1, 100) if "quality" in args else 80)]

    if target == "window":
        window = run_json(["hyprctl", "-j", "activewindow"])
        at, size = window.get("at"), window.get("size")
        if not at or not size:
            raise ToolError("there is no focused window to capture")
        command += ["-g", "%d,%d %dx%d" % (at[0], at[1], size[0], size[1])]
        label = "the focused window"
    elif target == "screen":
        output = focused_output()
        if output:
            command += ["-o", output]
        label = "the screen"
    else:
        names = [m.get("name") for m in run_json(["hyprctl", "-j", "monitors"])]
        if target not in names:
            raise ToolError("unknown target %r — use screen, window, or one of: %s" % (target, ", ".join(names)))
        command += ["-o", target]
        label = target

    path = os.path.join(STATE_DIR, "shot-%d.%s" % (os.getpid(), "jpg" if image_format == "jpeg" else "png"))
    ensure_dirs()
    try:
        run(command + [path], timeout=20)
        with open(path, "rb") as fh:
            raw = fh.read()
        if len(raw) > SCREENSHOT_MAX_BYTES:
            raise ToolError("screenshot is too large to return (%d bytes)" % len(raw))
        data = base64.b64encode(raw).decode("ascii")
    finally:
        try:
            os.unlink(path)
        except OSError:
            pass
    return ({"__image__": data, "__mime__": "image/jpeg" if image_format == "jpeg" else "image/png"},
            "took a screenshot of %s" % label)


def tool_read_clipboard(args):
    types = run(["wl-paste", "--list-types"], check=False).splitlines()
    types = [t.strip() for t in types if t.strip()]
    if not types:
        return {"empty": True}, "read the clipboard (empty)"
    if not any(t.startswith("text/") or t in ("TEXT", "STRING", "UTF8_STRING") for t in types):
        return ({"text": None, "types": types,
                 "note": "the clipboard holds non-text content, which this tool does not read"},
                "read the clipboard (non-text)")
    text = run(["wl-paste", "--no-newline"], check=False)
    if len(text) > CLIPBOARD_READ_LIMIT:
        return ({"text": text[:CLIPBOARD_READ_LIMIT], "length": len(text), "truncated": True},
                "read the clipboard (%d chars, truncated)" % len(text))
    return {"text": text, "length": len(text)}, "read the clipboard (%d chars)" % len(text)


def battery_status():
    base = "/sys/class/power_supply"
    if not os.path.isdir(base):
        return None
    for name in sorted(os.listdir(base)):
        path = os.path.join(base, name)
        try:
            with open(os.path.join(path, "type"), "r") as fh:
                if fh.read().strip() != "Battery":
                    continue
            with open(os.path.join(path, "capacity"), "r") as fh:
                percent = int(fh.read().strip())
            state = "unknown"
            try:
                with open(os.path.join(path, "status"), "r") as fh:
                    state = fh.read().strip().lower()
            except OSError:
                pass
            return {"name": name, "percent": percent, "state": state}
        except (OSError, ValueError):
            continue
    return None


def tool_get_system_stats(args):
    stats = {"theme": current_theme(), "battery": battery_status()}

    raw = run(["wpctl", "get-volume", "@DEFAULT_AUDIO_SINK@"], check=False)
    match = re.search(r"([0-9.]+)", raw)
    stats["volume"] = {
        "percent": int(round(float(match.group(1)) * 100)) if match else None,
        "muted": "MUTED" in raw.upper(),
    }

    brightness = run(["brightnessctl", "-m", "-c", "backlight"], check=False).strip()
    parts = brightness.split(",") if brightness else []
    stats["brightness"] = {"percent": int(parts[3].rstrip("%")) if len(parts) > 3 and parts[3].endswith("%") else None,
                           "device": parts[0] if parts else None}

    dnd = run(["omarchy-shell", "notifications", "isDnd"], check=False).strip().lower()
    stats["doNotDisturb"] = dnd == "on" if dnd in ("on", "off") else None

    workspace = run_json(["hyprctl", "-j", "activeworkspace"]) or {}
    stats["workspace"] = workspace.get("name")
    return stats, "read system stats"


# ---------------------------------------------------------------- writes

def tool_set_theme(args):
    requested = str(want(args, "name")).strip()
    names = theme_names()
    match = next((n for n in names if n.lower() == requested.lower()), None)
    if match is None:
        partial = [n for n in names if requested.lower() in n.lower()]
        if len(partial) == 1:
            match = partial[0]
        else:
            raise ToolError("no theme called %r. Installed themes: %s" % (requested, ", ".join(names)))
    run(["omarchy", "theme", "set", match], timeout=30)
    return {"theme": match}, "set the theme to %s" % match


def tool_set_wallpaper(args):
    path = args.get("path")
    if not path:
        run(["omarchy", "theme", "bg", "next"], timeout=20)
        return {"background": run(["omarchy", "theme", "bg", "current"], check=False).strip()}, \
               "moved to the next background"
    path = os.path.expanduser(str(path).strip())
    if not os.path.isabs(path):
        raise ToolError("path must be absolute")
    if not os.path.isfile(path):
        raise ToolError("no image at %s" % path)
    if not path.lower().endswith(IMAGE_EXTENSIONS):
        raise ToolError("path must be an image file (%s)" % ", ".join(IMAGE_EXTENSIONS))
    run(["omarchy", "theme", "bg", "set", path], timeout=20)
    return {"background": path}, "set the background to %s" % os.path.basename(path)


def tool_send_notification(args):
    title = str(want(args, "title")).strip()
    body = str(args.get("body") or "").strip()
    urgency = str(args.get("urgency") or "normal").strip().lower()
    if urgency not in ("low", "normal", "critical"):
        raise ToolError("urgency must be low, normal or critical")
    # omarchy-notification-send scans for options on both sides of the headline
    # and implements no `--` terminator, so a leading dash would be read as a
    # flag rather than as text. Refuse it here instead of hoping it is ignored.
    if title.startswith("-") or body.startswith("-"):
        raise ToolError("notification text may not begin with '-'")
    command = ["omarchy", "notification", "send", "--app-name", "OMCP", "-u", urgency, title]
    if body:
        command.append(body)
    run(command)
    return {"sent": True}, "sent a notification: %s" % title


def dispatch(expression):
    """Send one Hyprland dispatcher.

    Hyprland's dispatch surface is Lua now: `hyprctl dispatch` wraps whatever it
    is given in `hl.dispatch(...)`, so the old `dispatch movetoworkspace 3,addr`
    spelling is a syntax error rather than a no-op. Callers pass a `hl.dsp.*`
    expression instead. Everything interpolated into one has already been through
    want_address() or want_int(), so nothing reaches Lua unvalidated.
    """
    return run(["hyprctl", "dispatch", expression])


def tool_focus_window(args):
    address = want_address(args)
    dispatch('hl.dsp.focus({ window = "address:%s" })' % address)
    window = next((c for c in run_json(["hyprctl", "-j", "clients"]) if c.get("address") == address), {})
    return {"focused": address, "class": window.get("class"), "title": window.get("title")}, \
           "focused %s" % (window.get("class") or address)


def tool_move_window_to_workspace(args):
    address = want_address(args)
    workspace = want_int(args, "workspace", 1, 99)
    follow = want_bool(args, "follow", False)
    dispatch('hl.dsp.window.move({ workspace = "%d", window = "address:%s", follow = %s })'
             % (workspace, address, "true" if follow else "false"))
    return ({"address": address, "workspace": workspace, "followed": follow},
            "moved a window to workspace %d" % workspace)


def tool_switch_workspace(args):
    workspace = want_int(args, "workspace", 1, 99)
    dispatch('hl.dsp.focus({ workspace = "%d" })' % workspace)
    return {"workspace": workspace}, "switched to workspace %d" % workspace


def resolve_app(requested):
    """The one place an app name becomes a desktop entry.

    The approval prompt and the launch must agree on what "term" means. When
    they each resolved it separately — one exact-only, one with a substring
    fallback — the user could approve one app and have another start.
    """
    requested = str(requested).strip()
    entries = desktop_entries()
    entry = entries.get(requested)
    if entry is not None:
        return None if entry.get("hidden") else entry
    lowered = requested.lower()
    matches = [e for e in entries.values()
               if not e.get("hidden") and (e["name"].lower() == lowered or e["id"].lower() == lowered)]
    if not matches:
        matches = [e for e in entries.values() if not e.get("hidden") and lowered in e["name"].lower()]
    if len(matches) != 1:
        return None
    return matches[0]


def tool_launch_app(args):
    requested = str(want(args, "app")).strip()
    entry = resolve_app(requested)
    if entry is None:
        raise ToolError("no single app matches %r — call list_apps to see valid ids" % requested)
    launch_detached(["gio", "launch", entry["path"]])
    return {"launched": entry["id"], "name": entry["name"]}, "launched %s" % entry["name"]


def tool_open_url(args):
    url = want_url(args)
    launch_detached(["xdg-open", url])
    return {"opened": url}, "opened %s" % url


def tool_write_clipboard(args):
    text = want(args, "text")
    if not isinstance(text, str):
        raise ToolError("text must be a string")
    if len(text) > 100000:
        raise ToolError("text is too long to put on the clipboard (limit 100000 characters)")
    # wl-copy forks a daemon that owns the selection for as long as it is the
    # clipboard source. That child inherits our pipes, so capturing its output
    # would block until it dies rather than until the copy lands — hence the
    # explicit DEVNULL on all three streams.
    try:
        proc = subprocess.run(argv_trusted(["wl-copy", "--", text]), stdin=subprocess.DEVNULL,
                              stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, timeout=10)
    except subprocess.TimeoutExpired:
        raise ToolError("wl-copy did not finish in time")
    if proc.returncode != 0:
        raise ToolError("wl-copy exited with code %d" % proc.returncode)
    return {"copied": len(text)}, "put %d characters on the clipboard" % len(text)


def tool_set_volume(args):
    if "muted" in args and "percent" not in args:
        muted = want_bool(args, "muted")
        run(["wpctl", "set-mute", "@DEFAULT_AUDIO_SINK@", "1" if muted else "0"])
        return {"muted": muted}, "%s the audio" % ("muted" if muted else "unmuted")
    percent = want_int(args, "percent", 0, 100)
    run(["wpctl", "set-volume", "@DEFAULT_AUDIO_SINK@", "%d%%" % percent])
    if "muted" in args:
        run(["wpctl", "set-mute", "@DEFAULT_AUDIO_SINK@", "1" if want_bool(args, "muted") else "0"])
    return {"percent": percent}, "set the volume to %d%%" % percent


def tool_set_brightness(args):
    percent = want_int(args, "percent", 1, 100)
    probe = run(["brightnessctl", "-m", "-c", "backlight"], check=False).strip()
    if not probe:
        raise ToolError("this machine has no backlight device to control")
    run(["brightnessctl", "-c", "backlight", "set", "%d%%" % percent])
    return {"percent": percent}, "set the brightness to %d%%" % percent


def tool_set_do_not_disturb(args):
    enabled = want_bool(args, "enabled")
    run(["omarchy-shell", "notifications", "setDnd", "on" if enabled else "off"])
    return {"doNotDisturb": enabled}, "turned do not disturb %s" % ("on" if enabled else "off")


