    parts = [p for p in raw.split("\t") if p]
    return ({"kind": parts[0] if parts else None,
             "interface": parts[1] if len(parts) > 1 else None,
             "detail": parts[2] if len(parts) > 2 else None, "raw": raw},
            "read the network status")


def _night_light_on():
    try:
        return bool(json.loads(run(["omarchy", "toggle", "nightlight", "--status"], check=False) or "{}")
                    .get("enabled"))
    except ValueError:
        return None


def tool_set_night_light(args):
    wanted = want_bool(args, "enabled")
    # The command only toggles, so read first and act only if it disagrees —
    # otherwise "turn it on" turns it off when it was already on.
    current = _night_light_on()
    if current is None:
        raise ToolError("could not read the night light state")
    if current != wanted:
        # Turning it on starts hyprsunset, which stays running and holds the
        # pipes it inherited — waiting on it would block until the night light
        # was switched off again. Fire it detached, then confirm from the state
        # file rather than from the process.
        launch_detached(["omarchy", "toggle", "nightlight"], settle=0.4)
        for _ in range(30):
            if _night_light_on() == wanted:
                break
            time.sleep(0.1)
        else:
            raise ToolError("the night light did not change state")
    return {"nightLight": wanted}, "turned the night light %s" % ("on" if wanted else "off")


def tool_set_reminder(args):
    minutes = want_int(args, "minutes", 1, 1440)
    message = str(args.get("message") or "").strip()
    if message.startswith("-"):
        raise ToolError("reminder text may not begin with '-'")
    command = ["omarchy", "reminder", str(minutes)]
    if message:
        command.append(message)
    run(command)
    return ({"minutes": minutes, "message": message or None},
            "set a reminder for %d minutes" % minutes)


def tool_set_power_profile(args):
