# ------------------------------------------------------------ tool catalogue
#
# `default` is the permission this tool ships with. Reads that can pick up
# secrets (the clipboard) and anything that starts a process or writes into
# another app's input default to `ask` rather than `allow`, so a fresh install
# cannot be talked into them by a prompt-injected agent without the user seeing
# a prompt first.

def _s(properties=None, required=None):
    return {"type": "object", "properties": properties or {}, "required": required or [],
            "additionalProperties": False}


TOOLS = {
    "get_active_window": {
        "default": ALLOW, "write": False, "run": tool_get_active_window,
        "title": "Focused window",
        "description": "Return the currently focused window: class, title, workspace and its Hyprland address.",
        "schema": _s(),
    },
    "list_windows": {
        "default": ALLOW, "write": False, "run": tool_list_windows,
        "title": "List windows",
        "description": "List every open window with its Hyprland address, class, title and workspace. "
                       "Addresses from here are what focus_window and move_window_to_workspace accept.",
        "schema": _s(),
    },
    "list_workspaces": {
        "default": ALLOW, "write": False, "run": tool_list_workspaces,
        "title": "List workspaces",
        "description": "List Hyprland workspaces with their window counts and which one is active.",
        "schema": _s(),
    },
    "get_current_theme": {
        "default": ALLOW, "write": False, "run": tool_get_current_theme,
        "title": "Current theme",
        "description": "Return the name of the Omarchy theme currently applied.",
        "schema": _s(),
    },
    "list_themes": {
        "default": ALLOW, "write": False, "run": tool_list_themes,
        "title": "List themes",
        "description": "List every installed Omarchy theme. set_theme only accepts names from this list.",
        "schema": _s(),
    },
    "list_apps": {
